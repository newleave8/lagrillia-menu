/** Private order storage is never included in the public menu catalog. */
const PRE_STORE={id:'pangyo',name:'라그릴리아 판교점'};
const PRE_SHEETS={orders:'선주문_접수',lines:'선주문_상세'};
function checkoutPage_(channel){if(!/^[a-f0-9]{32}$/.test(String(channel||'')))throw Error('전송 화면을 장바구니에서 다시 열어주세요');const t=HtmlService.createTemplateFromFile('Checkout');t.channel=channel;return t.evaluate().setTitle('라그릴리아 판교점 선주문').addMetaTag('viewport','width=device-width,initial-scale=1').setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL)}
function preTime_(){return Utilities.formatDate(new Date(),'Asia/Seoul','yyyy-MM-dd HH:mm:ss')}
function preTable_(name){const sh=sheet_(name),values=sh.getDataRange().getValues();return {sh,values,records:rowsToRecords_(values)}}
function preDate_(value){const s=String(value||'');if(!/^\d{4}-\d{2}-\d{2}$/.test(s)||isNaN(Date.parse(s))||new Date(s+'T00:00:00Z').toISOString().slice(0,10)!==s)throw Error('예약일자를 확인하세요');return s}
function preServeTime_(value){const s=String(value||'');if(!/^(?:[01]\d|2[0-3]):[0-5]\d$/.test(s))throw Error('메뉴 제공 시간을 선택하세요');return s}
function preOrderTableForWrite_(){let t=preTable_(PRE_SHEETS.orders);if(!t.values[0].includes('메뉴제공시간')){t.sh.getRange(1,t.values[0].length+1,t.sh.getMaxRows(),1).setNumberFormat('@');t.sh.getRange(1,t.values[0].length+1).setValue('메뉴제공시간');t=preTable_(PRE_SHEETS.orders)}return t}
function preReceipt_(r){return {id:r['접수ID'],number:r['주문번호'],submittedAt:r['접수시간'],storeName:r['점포명'],date:r['예약일자'],serveTime:String(r['메뉴제공시간']||''),total:Number(r['예상총액'])||0}}
function preQuote_(lines){if(!Array.isArray(lines)||!lines.length||lines.length>50)throw Error('메뉴는 1~50개 항목까지 전달할 수 있습니다');const catalog=publicCatalog_();return lines.map((line,index)=>{const menu=catalog.menus.find(m=>m.id===line.menuId&&m.active);if(!menu||!Number.isSafeInteger(menu.price))throw Error('판매 메뉴를 다시 확인하고 담아주세요');const quantity=number_(line.quantity,'메뉴 수량',100);if(!quantity)throw Error('메뉴 수량은 1개 이상이어야 합니다');const requested=line.groups||[];if(!Array.isArray(requested)||requested.length!==menu.options.length)throw Error('선택 옵션을 다시 확인하세요');const seen=new Set(),options=[];let extra=0;for(const group of menu.options){const g=requested.find(x=>x.groupId===group.id);if(!g||seen.has(g.groupId)||!Array.isArray(g.items))throw Error('옵션 그룹 오류');seen.add(g.groupId);const itemIds=new Set();let count=0;for(const pick of g.items){if(itemIds.has(pick.itemId))throw Error('중복 옵션 오류');itemIds.add(pick.itemId);const item=group.items.find(x=>x.id===pick.itemId);if(!item)throw Error('옵션 항목을 다시 확인하세요');const n=number_(pick.quantity,'옵션 수량',100);if(!n||(!group.allowDuplicate&&n>1))throw Error('옵션 수량 오류');count+=n;extra+=item.extra*n;options.push({groupId:group.id,groupName:group.name,itemId:item.id,name:item.plainName||item.name,quantity:n,totalQuantity:n*quantity,extra:item.extra})}if(count<group.min||count>group.max)throw Error(group.name+' 선택 수량을 확인하세요')}if(!Number.isSafeInteger(line.expectedUnitPrice)||line.expectedUnitPrice!==menu.price+extra)throw Error('메뉴 가격이 변경되었습니다. 장바구니에서 해당 메뉴를 다시 담아주세요');return {index:index+1,menuId:menu.id,name:menu.plainName||menu.name,quantity,basePrice:menu.price,extra,unitPrice:menu.price+extra,amount:(menu.price+extra)*quantity,options}})}
function preAppend_(table,objects,ranges){if(!objects.length)return;const h=table.values[0],values=objects.map(o=>h.map(k=>safeCell_(o[k]??''))),start=table.values.length+1;if(typeof table.sh.getMaxRows==='function'&&start+values.length-1>table.sh.getMaxRows())table.sh.insertRowsAfter(table.sh.getMaxRows(),start+values.length-1-table.sh.getMaxRows());const range=table.sh.getRange(start,1,values.length,h.length);ranges.push(range);range.setValues(values)}
function submitPreorder(input){if(!input||JSON.stringify(input).length>100000)throw Error('전달할 내용이 너무 큽니다');if(input.storeId!==PRE_STORE.id)throw Error('판교점 선주문 화면에서 다시 전달해주세요');const requestId=text_(input.requestId,80);if(!/^[a-zA-Z0-9-]{16,80}$/.test(requestId))throw Error('전송 번호 오류');const serveTime=preServeTime_(input.serveTime),date=preDate_(input.date),name=text_(input.name,50).trim(),phone=String(input.phone||''),note=text_(input.note,1000).trim();if(!name)throw Error('고객 성함을 입력하세요');if(!/^\d{4}$/.test(phone))throw Error('휴대폰 뒤 4자리를 입력하세요');const fingerprint=hashRecords_([PRE_STORE.id,date,name,phone,note,input.lines,serveTime]);
 const lock=writeLock_();let orderTable;try{orderTable=preOrderTableForWrite_();const found=orderTable.records.find(r=>r['요청ID']===requestId);if(found){if(found['요청해시']!==fingerprint)throw Error('전송 내용이 변경되었습니다. 화면을 다시 열어주세요');return preReceipt_(found)}}finally{lock.releaseLock()}
 const quoted=preQuote_(input.lines),total=quoted.reduce((sum,l)=>sum+l.amount,0);if(!Number.isSafeInteger(total)||total>100000000)throw Error('주문 금액을 확인하세요');const writer=writeLock_(),ranges=[];try{orderTable=preOrderTableForWrite_();const previous=orderTable.records.find(r=>r['요청ID']===requestId);if(previous){if(previous['요청해시']!==fingerprint)throw Error('전송 내용이 변경되었습니다');return preReceipt_(previous)}const cache=CacheService.getScriptCache(),key='preorder-submit-minute',count=Number(cache.get(key)||0);if(count>=30)throw Error('접수가 일시적으로 몰리고 있습니다. 잠시 후 다시 전달해주세요');cache.put(key,String(count+1),60);const seq=orderTable.records.reduce((max,r)=>Math.max(max,Number(String(r['주문번호']).replace(/^LAG/,''))||0),0)+1;const id='pre-'+Utilities.getUuid(),now=preTime_(),record={'접수ID':id,'주문번호':'LAG'+String(seq).padStart(3,'0'),'접수시간':now,'점포ID':PRE_STORE.id,'점포명':PRE_STORE.name,'예약일자':date,'고객명':name,'연락처뒤4자리':phone,'고객요청사항':note,'메뉴제공시간':serveTime,'예상총액':total,'상태':'신규','확인시간':'','삭제시간':'','요청ID':requestId,'요청해시':fingerprint};preAppend_(preTable_(PRE_SHEETS.lines),quoted.map(l=>({'접수ID':id,'순번':l.index,'메뉴ID':l.menuId,'메뉴명':l.name,'수량':l.quantity,'기본단가':l.basePrice,'옵션단가':l.extra,'주문단가':l.unitPrice,'금액':l.amount,'옵션JSON':JSON.stringify(l.options)})),ranges);SpreadsheetApp.flush();preAppend_(orderTable,[record],ranges);SpreadsheetApp.flush();return preReceipt_(record)}catch(e){try{ranges.reverse().forEach(r=>r.clearContent());SpreadsheetApp.flush()}catch(rollbackError){console.error('선주문 복구 오류: '+rollbackError.message)}throw e}finally{writer.releaseLock()}}
function listPreorders(token,filter){requireAuth_(token);const f=filter||{},date=f.date?preDate_(f.date):'';return preTable_(PRE_SHEETS.orders).records.filter(r=>r['접수ID']&&r['점포ID']===PRE_STORE.id&&(!date||r['예약일자']===date)&&(f.deleted?r['상태']==='삭제':r['상태']!=='삭제')).map(r=>({...preReceipt_(r),name:r['고객명'],phone:String(r['연락처뒤4자리']).padStart(4,'0'),note:r['고객요청사항']||'',state:r['상태'],checkedAt:r['확인시간']||''})).sort((a,b)=>b.number.localeCompare(a.number,undefined,{numeric:true})).slice(0,1000)}
function getPreorder(token,id){requireAuth_(token);const r=preTable_(PRE_SHEETS.orders).records.find(r=>r['접수ID']===id);if(!r)throw Error('접수 내역을 찾을 수 없습니다');const lines=preTable_(PRE_SHEETS.lines).records.filter(l=>l['접수ID']===id).sort((a,b)=>Number(a['순번'])-Number(b['순번'])).map(l=>({name:l['메뉴명'],quantity:Number(l['수량']),unitPrice:Number(l['주문단가']),amount:Number(l['금액']),options:JSON.parse(l['옵션JSON']||'[]')}));return {...preReceipt_(r),name:r['고객명'],phone:String(r['연락처뒤4자리']).padStart(4,'0'),note:r['고객요청사항']||'',state:r['상태'],lines}}
function changePreorderState(token,id,action){requireAuth_(token);if(!['check','delete','restore'].includes(action))throw Error('처리 구분 오류');const lock=writeLock_();try{const table=preTable_(PRE_SHEETS.orders),h=table.values[0],i=table.values.findIndex((r,n)=>n>0&&r[h.indexOf('접수ID')]===id);if(i<1)throw Error('접수 내역을 찾을 수 없습니다');const row=table.values[i].slice(),state=h.indexOf('상태');if(action==='check'){if(row[state]==='삭제')throw Error('삭제된 내역입니다');row[state]='확인';row[h.indexOf('확인시간')]=preTime_()}else if(action==='delete'){row[state]='삭제';row[h.indexOf('삭제시간')]=preTime_()}else{row[state]=row[h.indexOf('확인시간')]?'확인':'신규';row[h.indexOf('삭제시간')]=''}table.sh.getRange(i+1,1,1,h.length).setValues([row.map(safeCell_)]);SpreadsheetApp.flush();return true}finally{lock.releaseLock()}}
